# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Reverse Proxy Trust Configuration
# Set to 'false' (default) if running directly without a reverse proxy.
# Set to '1' if deployed behind a single reverse proxy (e.g., Render, Railway, AWS ALB, Nginx).
# Set to 'true' or a CIDR subnet/IP list (e.g., 'loopback, 10.0.0.0/8') for specific proxy topologies.
TRUST_PROXY=false

# Refresh Cookie Configuration
# COOKIE_SAME_SITE: 'lax' (recommended for most setups), 'strict' (same-site only), or 'none' (cross-site HTTPS)
# NOTE: If 'none' is specified, cookies automatically enforce Secure=true.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN: Optional parent domain for cross-subdomain sharing (e.g., '.institution.edu')
# COOKIE_DOMAIN=

# Database Connection (Neon PostgreSQL)
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# DATABASE_URL: Neon pooled endpoint (for Express runtime queries)
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_cse_hub?schema=public"
# DIRECT_URL: Neon direct endpoint (for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/smart_cse_hub?schema=public"

# Initial Administrator Seed Credentials
# Use strong credentials when populating actual .env; never commit real credentials to git
INITIAL_ADMIN_EMAIL="admin@institution.edu"
INITIAL_ADMIN_PASSWORD="change-this-temporary-password"
INITIAL_ADMIN_FIRST_NAME="System"
INITIAL_ADMIN_LAST_NAME="Administrator"
INITIAL_ADMIN_CODE="ADM-001"

# JWT Secret Placeholders
# Must be distinct 256-bit (32+ character) cryptographically random strings in production
JWT_ACCESS_SECRET="replace-with-a-secure-random-access-secret-minimum-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
