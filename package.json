{
  "name": "smart-cse-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"client,server\" -c \"cyan.bold,magenta.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "build:all": "npm run build --prefix server && npm run build",
    "build:vercel": "npm --prefix server run prisma:generate && npm run build",
    "typecheck": "tsc -b --noEmit",
    "typecheck:server": "npm run typecheck --prefix server",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "lint": "oxlint",
    "test": "node --test tests/**/*.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
