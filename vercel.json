{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install && npm --prefix server install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
